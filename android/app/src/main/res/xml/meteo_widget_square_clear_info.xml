<?xml version="1.0" encoding="utf-8"?>
<!-- Widget "Meteo Zoo" trasparente (MeteoWidgetSquareClearProvider): come meteo_widget_square.xml ma senza fondo. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_square_clear_description"
    android:initialLayout="@layout/meteo_widget_square_clear"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="100dp"
    android:previewImage="@drawable/widget_preview_square_clear"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen" />
