# Chiave gratuita da https://home.openweathermap.org/api_keys
# Solo lato server: la usa il ponte /api/meteo (next dev e Vercel), mai il bundle.
# Su Vercel va impostata come variabile segreta OWM_API_KEY.
OWM_API_KEY=

# Facoltativo: ponte da usare al posto di https://meteo-zoo.vercel.app/api/meteo/
# (es. http://localhost:9005/api/meteo/ per provare il ponte con next dev).
# NEXT_PUBLIC_WEATHER_API=

# AdMob: finche' e' true si vedono solo annunci di test.
NEXT_PUBLIC_ADMOB_TEST_MODE=true
NEXT_PUBLIC_ADMOB_BANNER_AD_UNIT_ID_ANDROID=
NEXT_PUBLIC_ADMOB_INTERSTITIAL_AD_UNIT_ID_ANDROID=
