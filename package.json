{
  "name": "previsioni-animali",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack -p 9005",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "cap:sync": "npm run build:static && npx cap sync android",
    "android:bundle": "npm run cap:sync && cd android && gradlew.bat bundleRelease",
    "android:apk": "npm run cap:sync && cd android && gradlew.bat assembleRelease",
    "images": "node scripts/process-images.mjs",
    "prompts": "tsx scripts/prompts.ts",
    "android:icons": "node resources/icon/build-icon.mjs && npx @capacitor/assets generate --android --iconBackgroundColor \"#2184fe\" --iconBackgroundColorDark \"#2184fe\" --splashBackgroundColor \"#46a6fd\" --splashBackgroundColorDark \"#46a6fd\"",
    "import": "node scripts/import-downloads.mjs",
    "build:static": "node scripts/build-static.mjs"
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.1.0",
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/geolocation": "^8.0.0",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capgo/native-purchases": "^8.8.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "next": "15.5.9",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tailwind-merge": "^3.0.1",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@types/node": "^20",
    "@types/react": "^19.2.1",
    "@types/react-dom": "^19.2.1",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
